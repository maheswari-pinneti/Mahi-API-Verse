# ==========================================
# Mahi API Verse - Production Configuration
# Copy this file to .env and populate securely
# ==========================================

# 1. Database Configuration
POSTGRES_USER=mahi_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=mahi_api_verse
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# 2. Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
# Note: For production use rediss:// if TLS is enabled
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# 3. OpenSearch Configuration
OPENSEARCH_USERNAME=admin
# Must be at least 8 characters, with letters, numbers, and symbols
OPENSEARCH_PASSWORD=YourSecureOpensearchPassword123!
# Note: internal connections to OPENSEARCH might require https if security plugin is fully enabled
OPENSEARCH_URL=https://opensearch:9200

# 4. Web / API Configuration
NEXT_PUBLIC_API_URL=https://api.mahi-api-verse.com/v1

# 5. Application Secrets (Required for Auth/Session/JWTs)
SESSION_SECRET=generate_a_random_32_byte_string_here
JWT_SECRET=generate_a_random_32_byte_string_here
